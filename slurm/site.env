# Sourced by slurm/common.sh. Paths for the Euler runs.
#
# Project storage is NFS, scratch is Lustre, and conda writes tens of thousands
# of small files per environment. Both directories are therefore on project
# storage, and separate from any shared environment directory, so a
# --conda-cleanup-envs here cannot reach another project's environments.
CONDA_PREFIX_DIR=/cluster/project/platt/imallona/fastder-envs
APPTAINER_CACHEDIR=/cluster/project/platt/imallona/fastder-apptainer-cache

# Only needed when snakemake is not already on PATH. sbatch exports the
# submitting shell, so an activated environment carries into the job.
# CONDA_INIT=/cluster/project/platt/imallona/miniforge3/bin/activate
# CONDA_ENV=/cluster/project/platt/imallona/envs/snakemake
